{
  "name": "dag-hero",
  "private": true,
  "version": "0.1.0",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "record:snapshot": "node scripts/record-snapshot.mjs",
    "record:mainnet-60s": "node scripts/record-snapshot.mjs --api-url https://kgi.kaspad.net:3147 --duration-ms 60000 --poll-interval-ms 200 --height-difference 14 --out public/replay/mainnet-60s-compressed.json",
    "perf:check": "npm run build && node scripts/check-perf-budget.mjs"
  },
  "dependencies": {
    "@createjs/core": "2.0.0-beta.4",
    "@createjs/tweenjs": "2.0.0-beta.4",
    "pixi.js": "^8.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.3.0",
    "vite": "^8.0.8"
  }
}
